# Copiá este archivo a admin/.env y completá los valores.
# El .env NO se sube a ningún lado: chmod 600 admin/.env

# Clave de firma de las sesiones. Generala con:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiame-por-una-clave-larga-y-aleatoria

# Dominio público del sitio (para los links "Ver nota")
URL_SITIO=https://www.surfinanzas.com.ar

# Puerto interno donde escucha gunicorn (nginx hace de proxy)
PUERTO=8001

# Poné 1 SOLO para probar en tu máquina sin HTTPS.
# En el VPS tiene que estar en 0 o directamente no estar.
ADMIN_INSEGURO=0

# --- Formulario de contacto -------------------------------------------------
# Sin esto el formulario igual funciona: guarda los mensajes y se ven en el
# panel, en Mensajes. Al cargar las credenciales, además llegan por mail.
#
# Datos del proveedor de correo de surfinanzas.com.ar.
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=web@surfinanzas.com.ar
SMTP_PASSWORD=
SMTP_DESDE=web@surfinanzas.com.ar

# starttls (puerto 587, lo más común) | ssl (puerto 465) | ninguna
SMTP_SEGURIDAD=starttls

# Dónde se guardan los mensajes recibidos.
# Por defecto <proyecto>/datos — nginx tiene bloqueado ese directorio.
# DATOS_DIR=/var/lib/surfinanzas
