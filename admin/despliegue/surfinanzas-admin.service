# Copiar a /etc/systemd/system/surfinanzas-admin.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now surfinanzas-admin
#   sudo systemctl status surfinanzas-admin

[Unit]
Description=Panel del blog de Sur Finanzas
After=network.target

[Service]
Type=notify
User=www-data
Group=www-data
WorkingDirectory=/var/www/surfinanzas/admin
EnvironmentFile=/var/www/surfinanzas/admin/.env
# gunicorn escribe un socket de control dentro de $HOME. El home de www-data
# es /var/www, que acá queda de solo lectura: se le da un directorio propio
# en /run, que systemd crea y borra solo.
RuntimeDirectory=surfinanzas-admin
Environment=HOME=/run/surfinanzas-admin
ExecStart=/var/www/surfinanzas/.venv/bin/gunicorn \
    --workers 2 \
    --bind 127.0.0.1:8001 \
    --timeout 120 \
    --access-logfile - \
    --error-logfile - \
    app:app
Restart=always
RestartSec=5

# Endurecimiento: el servicio solo puede escribir donde hace falta.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
# El panel regenera el blog Y las páginas de servicios, así que necesita
# escribir también en servicios/, index.html y nosotros.html.
ReadWritePaths=/var/www/surfinanzas/blog \
               /var/www/surfinanzas/servicios \
               /var/www/surfinanzas/assets/blog \
               /var/www/surfinanzas/datos \
               /var/www/surfinanzas/admin \
               /var/www/surfinanzas/index.html \
               /var/www/surfinanzas/nosotros.html \
               /var/www/surfinanzas/sitemap.xml

[Install]
WantedBy=multi-user.target
